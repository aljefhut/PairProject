<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tripnesia - Jelajah Keindahan Nusantara</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">Tripnesia</a>
      <div>
        <% if (user) { %>
          <a href="/destinations" class="btn btn-outline-light me-2">Destinasi</a>
          <a href="/logout" class="btn btn-danger">Logout</a>
        <% } else { %>
          <a href="/login" class="btn btn-outline-light me-2">Login</a>
          <a href="/register" class="btn btn-primary">Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container text-center my-5 py-5">
    <h1 class="display-4 fw-bold">Selamat Datang di Tripnesia</h1>
    <p class="lead text-muted">Platform pemesanan tiket destinasi wisata terbaik dan terpercaya di Indonesia.</p>
    <a href="/destinations" class="btn btn-success btn-lg mt-3">Jelajahi Tempat Wisata</a>
  </div>
</body>
</html>