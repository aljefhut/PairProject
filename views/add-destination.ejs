<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tambah Destinasi - Tripnesia</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container col-md-6 my-5">
    <div class="card p-4 shadow-sm">
      <h3>Tambah Destinasi Baru</h3>
      <% if (errors.length > 0) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% errors.forEach(err => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <form action="/destinations/add" method="POST">
        <div class="mb-3">
          <label class="form-label">Nama Tempat Wisata</label>
          <input type="text" name="name" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Kategori</label>
          <select name="CategoryId" class="form-select" required>
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Lokasi / Kota</label>
            <input type="text" name="location" class="form-control" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Harga Tiket (Rp)</label>
            <input type="number" name="price" class="form-control" required>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Image URL</label>
          <input type="url" name="imageUrl" class="form-control">
        </div>
        <div class="mb-3">
          <label class="form-label">Deskripsi</label>
          <textarea name="description" class="form-control" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Simpan Destinasi</button>
        <a href="/destinations" class="btn btn-secondary">Batal</a>
      </form>
    </div>
  </div>
</body>
</html>