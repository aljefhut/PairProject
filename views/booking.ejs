<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tiket Saya - Tripnesia</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/booking.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">Tripnesia</a>
      <a href="/destinations" class="btn btn-outline-light">Kembali ke Katalog</a>
    </div>
  </nav>

  <section class="page-top">
    <div class="container my-5">
      <h2>Daftar Tiket Pesanan Saya</h2>
      <p class="text-muted">Bukti e-Tiket juga telah dikirimkan ke email terdaftar Anda.</p>

      <div class="row mt-4">
        <% if (bookings.length === 0) { %>
          <p class="text-muted">Belum ada pemesanan tiket.</p>
        <% } %>
        <% bookings.forEach(b => { %>
          <div class="col-md-6 mb-3">
            <div class="card shadow-sm border-success">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h5 class="card-title mb-0"><%= b.Destination.name %></h5>
                  <span class="badge bg-success"><%= b.status %></span>
                </div>
                <p class="text-muted small mb-1">📍 <%= b.Destination.location %></p>
                <p class="text-muted small mb-1">📅 Tanggal Kunjungan: <%= new Date(b.bookingDate).toLocaleDateString('id-ID') %></p>
                <p class="mb-1">🎟️ Jumlah Tiket: <strong><%= b.totalTicket %></strong> lembar</p>
                <h6 class="text-success fw-bold mt-2"><%= formatRupiah(b.totalPrice) %></h6>
                <div class="alert alert-info py-1 px-2 mt-2 mb-0 small text-center">
                  📧 e-Tiket Terkirim ke Email
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="page-bottom">
    <div class="container page-bottom-content">
      <h3 class="page-bottom-title">Terima kasih sudah mempercayai Tripnesia! 🙏</h3>
      <p class="page-bottom-text">Masih ada waktu luang? Yuk jelajahi destinasi wisata lainnya di Indonesia.</p>
      <a href="/destinations" class="btn page-bottom-btn">Jelajahi Destinasi Lain</a>
    </div>
  </section>
</body>
</html>